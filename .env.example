# ── Telegram ────────────────────────────────────────────────────────────────
# Obtain at https://my.telegram.org/apps
TG_API_ID=
TG_API_HASH=

# Session name (short string → file-based) or a Telethon StringSession value
# (long string, generated once via `python -c "from telethon.sync import TelegramClient; from telethon.sessions import StringSession; c = TelegramClient(StringSession(), API_ID, API_HASH); c.start(); print(c.session.save())"`)
TG_SESSION=userbot

# ── Target chat ──────────────────────────────────────────────────────────────
# Numeric chat ID (negative for groups/supergroups, e.g. -1001234567890)
CHAT_ID=
# Forum topic ID — leave empty to listen to all topics
TOPIC_ID=

# ── Mode ─────────────────────────────────────────────────────────────────────
# BOT_MODE=dialog   — thread-based conversation (default)
#                     triggers: TRIGGER_WORDS, @mention, reply to bot
# BOT_MODE=file_qa  — answer questions about an uploaded file
#                     triggers: "<BOT_NAME>, подскажи <вопрос>"
BOT_MODE=dialog

# Name used to trigger file_qa mode (case-insensitive)
# Example trigger: "Кирилл, подскажи как получить справку?"
BOT_NAME=Кирилл

# GigaChat file ID — required for file_qa mode
# Get it by running: python upload_file.py <path_to_file>
GIGACHAT_FILE_ID=

# ── Debug ────────────────────────────────────────────────────────────────────
# Set to 1 to enable verbose logging: incoming messages, full prompts, GigaChat responses
DEBUG=0

# ── Behaviour ────────────────────────────────────────────────────────────────
# Comma-separated list of trigger words (case-insensitive)
TRIGGER_WORDS=привет,помоги,бот

# System prompt sent to GigaChat on every request
SYSTEM_PROMPT=Ты дерзкий, саркастичный собеседник. Отвечай кратко, с юмором, не более 3 предложений.

# How many previous messages to include as context
MAX_CONTEXT_MESSAGES=10

# Minimum seconds between consecutive replies in the same chat/topic
RATE_LIMIT_SECONDS=5

# ── GigaChat ─────────────────────────────────────────────────────────────────
# Авторизационные данные из кабинета developers.sber.ru/studio
# Проект → вкладка "Доступы" → поле "Авторизационные данные" (уже готовая base64-строка)
# НЕ нужно кодировать вручную — копируйте как есть
GIGACHAT_AUTH_KEY=

# GIGACHAT_API_PERS  — personal account
# GIGACHAT_API_CORP  — corporate account
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Model variant: GigaChat | GigaChat-Plus | GigaChat-Pro
GIGACHAT_MODEL=GigaChat

# Optional HTTP/SOCKS5 proxy for GigaChat API (needed if server is outside Russia)
# Examples:
#   GIGACHAT_PROXY=http://user:pass@host:3128
#   GIGACHAT_PROXY=socks5://user:pass@host:1080
GIGACHAT_PROXY=
